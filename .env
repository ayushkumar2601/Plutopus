# Environment variables template for Plutopus

# Database configuration (TimescaleDB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plutopus
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plutopus

# API configuration
PROJECT_NAME="Plutopus API"
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
JWT_SECRET=replace_me_with_a_secure_minimum_32_character_key_here

# CLI configuration
PLUTOPUS_API_URL=http://localhost:8000

# Dashboard configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Qdrant configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Redpanda configuration
REDPANDA_BROKERS=localhost:19092

# Ollama configuration
OLLAMA_BASE_URL=http://localhost:11434
